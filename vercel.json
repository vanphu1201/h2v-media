{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/_server/(.*)", "destination": "/api/index.js" },
    {
      "source": "/(.*)",
      "destination": "/api/index.js",
      "checkInternalReactions": true
    }
  ]
}
